{
  "name": "shalapao",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "แอปกระเป๋าเงินหลายใบบน LINE — เก็บเงิน ตั้งเป้า และกระทบยอดให้ตรงธนาคารเสมอ",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create shalapao",
    "db:local": "wrangler d1 migrations apply shalapao --local",
    "db:remote": "wrangler d1 migrations apply shalapao --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "ulid": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
