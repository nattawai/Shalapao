# คัดลอกไฟล์นี้เป็น .dev.vars แล้วเติมค่าจริง
# .dev.vars อยู่ใน .gitignore แล้ว — ห้าม commit เด็ดขาด
#
# ค่าจริงหาได้จาก developers.line.biz
# ดูว่า channel ไหนของโปรเจกต์นี้ที่ ../_docs/line-provider-channels.md

# บอท (Messaging API · v3 webhook) — ยังไม่ต้องตั้งใน v0
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF_LOGIN_CHANNEL_ID ไม่ใช่ความลับ ตั้งใน wrangler.toml [vars] แล้ว
# ใส่ที่นี่ด้วยเฉพาะตอน dev ถ้าอยากคุมค่าเอง (ไม่บังคับ)
LIFF_LOGIN_CHANNEL_ID=
